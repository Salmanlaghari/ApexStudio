<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- The test APK shares Startup classes from its instrumented target.
             ActivityScenario's out-of-process helper Activity cannot load those
             classes on API 29. It needs no Perfetto cold-start initializer.
             Remove only this test-package provider; production Startup stays intact. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />
    </application>
</manifest>
