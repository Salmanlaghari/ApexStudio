<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:dist="http://schemas.android.com/apk/distribution"
    xmlns:tools="http://schemas.android.com/tools">
    <dist:module dist:title="@string/app_name">
        <dist:delivery>
            <dist:on-demand />
        </dist:delivery>
        <dist:fusing dist:include="false" />
    </dist:module>
    <application>
        <activity
            android:name=".CameraKitActivity"
            android:exported="false"
            android:theme="@style/Theme.ApexStudio" />
        <!-- Feature activity manifest metadata is linked with the base APK.
             Keep only its tiny window theme in base; SDK code stays on demand. -->
        <activity android:name="com.snap.camerakit.LegalPromptActivity"
            android:theme="@style/Theme.ApexStudio.CameraKitLegal" tools:replace="android:theme" />
        <activity android:name="com.snap.camerakit.LegalPrePromptVariantGActivity"
            android:theme="@style/Theme.ApexStudio.CameraKitLegal" tools:replace="android:theme" />
        <activity android:name="com.snap.camerakit.diagnostics.DiagnosticsExportActivity"
            android:theme="@style/Theme.ApexStudio.CameraKitLegal" tools:replace="android:theme" />
    </application>
</manifest>
